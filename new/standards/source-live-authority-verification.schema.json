{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovetree.local/schema/source-live-authority-verification-1.0.json",
  "title": "LoveTree Live Source Authority Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA_VERSION",
    "CAPSULE_ID",
    "AUTHORITY_RECORD_SHA256",
    "AUTHORITY_RECORD_REVISION",
    "OBSERVATION_MODE",
    "DRIVE_FOLDER_ID",
    "DRIVE_FILE_ID",
    "OBSERVED_BYTES",
    "OBSERVED_SHA256",
    "OBSERVED_AT",
    "VERIFIER",
    "EVIDENCE_REF",
    "STATUS"
  ],
  "properties": {
    "SCHEMA_VERSION": { "const": "1.0" },
    "CAPSULE_ID": { "type": "string", "pattern": "^SRC[0-9]{3}$" },
    "AUTHORITY_RECORD_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "AUTHORITY_RECORD_REVISION": { "type": "integer", "minimum": 1 },
    "OBSERVATION_MODE": { "const": "GOOGLE_DRIVE_LIVE_BOUNDED_READ" },
    "DRIVE_FOLDER_ID": { "type": "string", "minLength": 1 },
    "DRIVE_FILE_ID": { "type": "string", "minLength": 1 },
    "OBSERVED_BYTES": { "type": "integer", "minimum": 0 },
    "OBSERVED_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "OBSERVED_AT": { "type": "string", "format": "date-time" },
    "VERIFIER": { "enum": ["WEB", "LUNA1", "TRUSTED_DRIVE_OBSERVER"] },
    "EVIDENCE_REF": { "type": "string", "minLength": 1 },
    "STATUS": { "enum": ["PASS", "FAIL", "BLOCKED"] }
  }
}
