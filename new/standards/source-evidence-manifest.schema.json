{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovetree.local/schema/source-evidence-manifest-1.0.json",
  "title": "LoveTree Source Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA_VERSION",
    "CAPSULE_ID",
    "SOURCE_SHA256",
    "AUTHORITY_RECORD_SHA256",
    "AUTHORITY_RECORD_REVISION",
    "ARTIFACTS"
  ],
  "properties": {
    "SCHEMA_VERSION": { "const": "1.0" },
    "CAPSULE_ID": { "type": "string", "pattern": "^SRC[0-9]{3}$" },
    "SOURCE_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "AUTHORITY_RECORD_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "AUTHORITY_RECORD_REVISION": { "type": "integer", "minimum": 1 },
    "ARTIFACTS": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ROLE", "PATH", "SHA256", "VIEWPORT", "STATE"],
        "properties": {
          "ROLE": { "type": "string", "minLength": 1 },
          "PATH": { "type": "string", "minLength": 1 },
          "SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "VIEWPORT": { "type": ["string", "null"] },
          "STATE": { "type": ["string", "null"] }
        }
      }
    }
  }
}
