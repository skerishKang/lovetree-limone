{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"$id":"https://lovetree.local/schema/source-authority-record-1.0.json","title":"LoveTree Source Authority Record","type":"object","required":["schema_version","source_id","source_family","revision","authority","adoption","duplicates"],"properties":{"schema_version":{"const":"1.0"},"source_id":{"type":"string","pattern":"^SRC[0-9]{3}$"},"source_family":{"type":"string","minLength":1},"revision":{"type":"string","minLength":1},"authority":{"type":"object","additionalProperties":false,"required":["mode","filename","bytes","sha256","captured_at"],"properties":{"mode":{"enum":["EXACT_COPY","AUTHORITY_POINTER"]},"filename":{"type":"string","minLength":1},"bytes":{"type":"integer","minimum":0},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"captured_at":{"type":"string","format":"date-time"},"drive_folder_id":{"type":"string","minLength":1},"drive_file_id":{"type":"string","minLength":1}}},"adoption":{"type":"object","additionalProperties":false,"required":["status","decision_source","adopted_revision","evidence_ref"],"properties":{"status":{"enum":["ADOPTED","UNRESOLVED","REJECTED"]},"decision_source":{"enum":["OWNER","DELEGATED_OWNER","GOVERNED_RECORD","UNRESOLVED"]},"adopted_revision":{"type":["string","null"]},"evidence_ref":{"type":["string","null"]}}},"duplicates":{"type":"object","additionalProperties":false,"required":["status","alternatives"],"properties":{"status":{"enum":["CLEAR","OPEN"]},"alternatives":{"type":"array","items":{"type":"object"}}}}}}