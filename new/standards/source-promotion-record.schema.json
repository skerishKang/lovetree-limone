{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lovetree.local/schema/source-promotion-record-1.0.json",
  "title": "LoveTree Source Promotion Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SCHEMA_VERSION",
    "CAPSULE_ID",
    "SOURCE_SHA256",
    "AUTHORITY_RECORD_SHA256",
    "AUTHORITY_RECORD_REVISION",
    "EXACT_PORT_HEAD_SHA",
    "EXACT_PRODUCT_HEAD_SHA",
    "PRODUCT_BOUND_PATHS",
    "SOURCE_PORT_PARITY_RECORD_SHA256",
    "SOURCE_PRODUCT_PARITY_RECORD_SHA256",
    "EVIDENCE_MANIFEST_SHA256",
    "WEB_VERIFICATION",
    "LUNA1_VERIFICATION",
    "STAGES",
    "PROMOTION_STATUS"
  ],
  "properties": {
    "SCHEMA_VERSION": { "const": "1.0" },
    "CAPSULE_ID": { "type": "string", "pattern": "^SRC[0-9]{3}$" },
    "SOURCE_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "AUTHORITY_RECORD_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "AUTHORITY_RECORD_REVISION": { "type": "integer", "minimum": 1 },
    "EXACT_PORT_HEAD_SHA": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "EXACT_PRODUCT_HEAD_SHA": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "PRODUCT_BOUND_PATHS": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "SOURCE_PORT_PARITY_RECORD_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "SOURCE_PRODUCT_PARITY_RECORD_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "EVIDENCE_MANIFEST_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "WEB_VERIFICATION": { "$ref": "#/$defs/verifier" },
    "LUNA1_VERIFICATION": { "$ref": "#/$defs/verifier" },
    "STAGES": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "S10"],
      "properties": {
        "S0": { "$ref": "#/$defs/pass" },
        "S1": { "$ref": "#/$defs/pass" },
        "S2": { "$ref": "#/$defs/pass" },
        "S3": { "$ref": "#/$defs/pass" },
        "S4": { "$ref": "#/$defs/pass" },
        "S5": { "$ref": "#/$defs/pass" },
        "S6": { "$ref": "#/$defs/pass" },
        "S7": { "$ref": "#/$defs/pass" },
        "S8": { "$ref": "#/$defs/pass" },
        "S9": { "$ref": "#/$defs/pass" },
        "S10": { "$ref": "#/$defs/pass" }
      }
    },
    "PROMOTION_STATUS": { "enum": ["READY", "HOLD", "REJECTED"] }
  },
  "$defs": {
    "pass": { "enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN", "NOT_STARTED"] },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STATUS", "RECORD_SHA256", "VERIFIED_HEAD_SHA"],
      "properties": {
        "STATUS": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "RECORD_SHA256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "VERIFIED_HEAD_SHA": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    }
  }
}
