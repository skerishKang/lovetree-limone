{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "preview:deploy:safe": "node scripts/deploy-isolated-preview.mjs",
    "v4:e2e:preflight": "node scripts/check-v4-runtime-e2e-preflight.mjs",
    "v4:e2e:verify-runtime": "node scripts/verify-v4-runtime-e2e-target.mjs",
    "v4:e2e:cleanup": "node scripts/cleanup-v4-runtime-e2e.mjs",
    "production:build:safe": "node scripts/build-production-safe.mjs",
    "production:deploy:safe": "node scripts/deploy-production-safe.mjs",
    "build": "vinext build && node scripts/prune-rsc-assets.mjs",
    "start": "node scripts/apply-vinext-static-cache-posix-keys.mjs && vinext start",
    "postinstall": "node scripts/apply-vinext-static-cache-posix-keys.mjs",
    "test": "npm run build && node --import tsx --test 'tests/*.test.mjs'",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "design:intake:validate": "node --import tsx scripts/design-intake-validate.mjs",
    "design:intake:scaffold": "node --import tsx scripts/design-intake-scaffold.mjs",
    "design:intake:freshness": "node --import tsx scripts/design-intake-source-freshness.mjs",
    "design:intake:observe": "node --import tsx scripts/design-intake-drive-observe.mjs",
    "design:intake:freshness:live": "node --import tsx scripts/design-intake-source-freshness-live.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "0.45.2",
    "firebase": "^12.17.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "pg": "^8.22.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": "4.20260625.0",
    "workerd": "1.20260625.1"
  }
}
