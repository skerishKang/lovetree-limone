    completedTreeGlow:1.34
  };
  const defaults={...params};
  const nodesData=[
    {id:'m1',x:.28,y:.40,color:'#f3ecde',accent:'#FFD36A',wash:'rgba(255,211,106,.10)',k:'FIRST MOMENT',title:'처음 멈춰 본 장면',meta:['2026.05.12','궁금함']},
    {id:'m2',x:.46,y:.49,color:'#9ce8ef',accent:'#38E8FF',wash:'rgba(56,232,255,.10)',k:'NEXT MOMENT',title:'표정이 자꾸 생각나서',meta:['+ 18 min','다시 검색']},
    {id:'m3',x:.68,y:.34,color:'#b8a6ff',accent:'#8B5CFF',wash:'rgba(139,92,255,.10)',k:'MOMENT 03',title:'무대 밖 말투가 궁금해져',meta:['+ 41 min','호기심']},
    {id:'m4',x:.81,y:.52,color:'#ef9bb7',accent:'#FF4FA3',wash:'rgba(255,79,163,.095)',k:'MOMENT 04',title:'웃는 순간에서 마음이 움직여',meta:['+ 1 h','설렘']},
    {id:'m5',x:.58,y:.67,color:'#dfcda7',accent:'#FFD36A',wash:'rgba(255,211,106,.095)',k:'MOMENT 05',title:'팬의 추천을 따라간 밤',meta:['DAY 2','놀람']},
    {id:'m6',x:.35,y:.76,color:'#b8a6ff',accent:'#A56BFF',wash:'rgba(165,107,255,.10)',k:'MOMENT 06',title:'이제 좋아한다고 인정해',meta:['DAY 3','몰입']},
    {id:'m7',x:.69,y:.81,color:'#ef9bb7',accent:'#FF5AC8',wash:'rgba(255,90,200,.10)',k:'TURNING POINT',title:'완전히 빠진 순간',meta:['DAY 5','FALL IN LOVE']}
  ];
  const edgesData=[
    {id:'e1',from:'m1',to:'m2',colors:['#38E8FF','#418CFF'],label:'Because the expression stayed with me…'},
    {id:'e2',from:'m2',to:'m3',colors:['#38E8FF','#8B5CFF'],label:'I wanted to see another side.'},
    {id:'e3',from:'m3',to:'m4',colors:['#8B5CFF','#FF4FA3'],label:'That small laugh changed the feeling.'},
    {id:'e4',from:'m4',to:'m5',colors:['#FF4FA3','#A56BFF'],label:'A fan said: watch this next.'},
    {id:'e5',from:'m5',to:'m6',colors:['#A56BFF','#418CFF'],label:'I kept searching on my own.'},
    {id:'e6',from:'m6',to:'m7',colors:['#418CFF','#FF5AC8'],label:'This was the moment I admitted it.'}
  ];
  const state={running:false,paused:false,token:0,fromNode:0,speedMult:1,mode:'lovetree',replayProgress:0};
  const q=new URLSearchParams(location.search);
  const el={app:document.getElementById('app'),wrap:document.getElementById('treeWrap'),svg:document.getElementById('flowSvg'),defs:document.getElementById('flowDefs'),nodes:document.getElementById('nodes'),connectionLayer:document.getElementById('connectionLayer'),activeGlowLayer:document.getElementById('activeGlowLayer'),activePathLayer:document.getElementById('activePathLayer'),outlineLayer:document.getElementById('nodeOutlineLayer'),memoryLayer:document.getElementById('memoryLayer'),trailLayer:document.getElementById('trailLayer'),tipLayer:document.getElementById('tipLayer'),relationPop:document.getElementById('relationPop'),timelineFill:document.getElementById('timelineFill'),message:document.getElementById('message'),play:document.get