ont-weight:400;font-size:clamp(21px,2vw,32px);letter-spacing:-.025em;color:#e8e2da}.message span{display:block;color:#777278;font-size:10px;letter-spacing:.17em;text-transform:uppercase;margin-top:7px}
.relation-pop{position:absolute;z-index:11;pointer-events:none;opacity:0;transform:translate(-50%,-50%) translateY(5px);transition:opacity .16s ease,transform .16s ease;background:rgba(18,19,24,.92);border:1px solid rgba(255,255,255,.08);border-radius:999px;padding:8px 12px;color:#cfc9c2;font-size:10px;box-shadow:0 12px 36px rgba(0,0,0,.4);white-space:nowrap}.relation-pop.show{opacity:1;transform:translate(-50%,-50%)}
.debug{display:none;position:absolute;right:18px;top:18px;width:270px;z-index:30;background:rgba(19,20,25,.94);border:1px solid rgba(255,255,255,.1);border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.58);padding:14px;backdrop-filter:blur(20px)}.debug.visible{display:block}.debug h2{font-size:13px;margin:0 0 3px}.debug .sub{font-size:9px;color:#77737a;margin-bottom:12px}.mode-toggle{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:#0d0e12;border-radius:10px;padding:3px;margin-bottom:16px}.mode-toggle button{border:0;border-radius:8px;padding:8px 6px;font-size:8px;letter-spacing:.1em;text-transform:uppercase;color:#777;background:transparent;cursor:pointer}.mode-toggle button.active{background:#2a2b31;color:#eee}.row{display:grid;grid-template-columns:1fr 64px;gap:10px;align-items:center;margin:8px 0}.row label{font-size:9px;color:#aaa5a4}.row input[type=range]{grid-column:1 / -1;width:100%;accent-color:#d8d2ca}.value{font-size:9px;text-align:right;color:#d7d2cc;font-variant-numeric:tabular-nums}.debug .buttons{display:flex;gap:6px;margin-top:12px}.debug .buttons button{flex:1;border:1px solid rgba(255,255,255,.08);background:#23242a;color:#aaa;padding:8px;border-radius:9px;font-size:9px;cursor:pointer}
.benchmark .moment{background:linear-gradient(145deg,rgba(32,34,44,.78),rgba(17,18,26,.75));--node-color:#8da8ff !important;--node-wash:rgba(100,125,255,.11)!important}.benchmark .hero-copy h1{color:#d9ddf2}.benchmark .hero-copy p{color:#777b8b}.benchmark .message strong{color:#dfe4ff}
@media(max-width:900px){.stage-shell{min-height:780px}.hero-copy{top:26px;max-width:270px}.hero-copy p{display:none}.tree-wrap{min-height:710px}.moment{width:150px;min-height:69px;padding:12px 13px}.moment .title{font-size:14px}.moment .meta{font-size:8px}.controls{bottom:20px;max-width:calc(100% - 24px);gap:2px}.controls button{padding:10px 10px;font-size:8px}.timeline{bottom:78px}.message{right:20px;top:110px;bottom:auto}.debug{right:8px;top:8px;width:245px}}
@media(max-width:560px){.topbar{height:58px;padding:0 16px}.brand span,.status{display:none}.stage-shell{padding:10px;min-height:730px}.tree-wrap{border-radius:20px;min-height:690px}.hero-copy{left:20px;top:22px}.hero-copy h1{font-size:31px;max-width:230px}.eyebrow{font-size:8px}.moment{width:128px;min-height:62px;padding:10px 11px}.moment .kicker{font-size:6.5px;margin-bottom:5px}.moment .title{font-size:12.5px}.moment .meta{font-size:7px;margin-top:6px}.controls{width:auto;bottom:14px}.controls button{padding:9px 8px;font-size:7px}.timeline{left:16px;right:16px;bottom:68px}.message{display:none}.debug{position:fixed;top:64px;right:8px;max-height:calc(100vh - 74px);overflow:auto}}
@media(prefers-reduced-motion:reduce){.moment,.message,.connection-track,.connection-active-outer,.connection-active-inner,.connection-memory,.node-memory{transition:none!important}.flow-bloom{display:none}}
</style>
</head>
<body>
<div class="app" id="app">
  <header class="topbar">
    <div class="brand"><div class="brand-mark" aria-hidden="true"></div><div><strong>LoveTree</strong><span>Emotional Path Replay</span></div></div>
    <div class="status" id="statusText">Motion system · v2</div>
  </header>
  <main class="stage-shell">
    <section class="tree-wrap" id="treeWrap" aria-label="LoveTree Moment connection replay demo">
      <div class="hero-copy"><div class="eyebrow">Moment → Connection → Moment</div><h1>Follow the feeling<br>that moved you.</h1><p>빛은 장식이 아니라 다음 순간을 찾아가게 만든 감정의 인과관계를 따라 이동합니다.</p></div>
      <svg class="flow-svg" id="flowSvg" aria-hidden="true"><defs id="flowDefs">
        <filter id="softGlow" x="-120%" y="-120%" width="340%" height="340%"><feGaussianBlur stdDeviation="4.6" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="hotGlow" x="-180%" y="-180%" width="460%" height="460%"><feGaussianBlur stdDeviation="7.8" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="sharpGlow" x="-100%" y="-100%" width="300%" height="300%"><feGaussianBlur stdDeviation="1.1" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="connectionBloom" x="-100%" y="-200%" width="300%" height="500%"><feGaussianBlur stdDeviation="7.2"/></filter>
        <filter id="memoryGlow" x="-100%" y="-150%" width="300%" height="400%"><feGaussianBlur stdDeviation="2.1" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs><g id="connectionLayer"></g><g id="activeGlowLayer"></g><g id="activePathLayer"></g><g id="nodeOutlineLayer"></g><g id="memoryLayer"></g><g id="trailLayer"></g><g id="tipLayer"></g></svg>
      <div class="nodes" id="nodes"></div>
      <div class="relation-pop" id="relationPop"></div>
      <div class="message" id="message"><strong>YOUR MOMENTS BECOME A PATH.</strong><span>Replay the route that made your heart move.</span></div>
      <div class="timeline"><div class="timeline-fill" id="timelineFill"></div><div class="timeline-label">Emotional path replay</div></div>
      <div class="controls" role="group" aria-label="Path replay controls"><button class="primary" id="playBtn">PLAY PATH</button><button id="pauseBtn">PAUSE</button><button id="replayBtn">REPLAY</button><button id="speedBtn">SPEED 1×</button></div>
      <aside class="debug" id="debugPanel" aria-label="Motion debug controls"><h2>Motion Control</h2><div class="sub">V2 connection visibility tuning · ?debug=1</div><div class="mode-toggle"><button id="modeBenchmark">BENCHMARK</button><button class="active" id="modeLoveTree">LOVETREE</button></div><div id="debugRows"></div><div class="buttons"><button id="resetDebug">Reset</button><button id="closeDebug">Hide</button></div></aside>
    </section>
  </main>
</div>
<script>
(() => {
  'use strict';
  const NS='http://www.w3.org/2000/svg';
  const params={
    speed:1.05,
    trailLength:58,
    shimmerOpacity:.78,
    tipSize:4.25,
    borderRadius:21,
    strokeWidth:1.45,
