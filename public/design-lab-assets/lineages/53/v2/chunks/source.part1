<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>LoveTree · Moment Node Light Flow v2</title>
<style>
:root{
  color-scheme:dark;
  --bg:#090a0d;
  --bg2:#0d0e12;
  --panel:rgba(17,18,23,.72);
  --panel-solid:#121319;
  --ink:#f3efe8;
  --muted:#958f88;
  --faint:#57535a;
  --hair:rgba(255,255,255,.08);
  --track:rgba(230,226,220,.06);
  --ivory:#f3ecde;
  --cyan:#9ce8ef;
  --violet:#b8a6ff;
  --rose:#ef9bb7;
  --gold:#dfcda7;
  --shadow:0 22px 80px rgba(0,0,0,.46);
  --radius:24px;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:var(--bg);font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink)}
button,input{font:inherit}
body{
  background:
    radial-gradient(circle at 18% 16%,rgba(184,166,255,.055),transparent 28%),
    radial-gradient(circle at 82% 78%,rgba(239,155,183,.045),transparent 30%),
    linear-gradient(180deg,#090a0d 0%,#0a0b0f 45%,#08090c 100%);
  overflow-x:hidden;
}
.app{min-height:100vh;display:flex;flex-direction:column}
.topbar{height:70px;padding:0 clamp(18px,4vw,54px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(255,255,255,.055);position:relative;z-index:12;background:rgba(9,10,13,.62);backdrop-filter:blur(16px)}
.brand{display:flex;gap:12px;align-items:center}.brand-mark{width:28px;height:28px;position:relative}.brand-mark:before,.brand-mark:after{content:"";position:absolute;border:1px solid rgba(243,236,222,.32);border-radius:50%}.brand-mark:before{inset:2px 8px 9px 2px;transform:rotate(-25deg)}.brand-mark:after{inset:9px 2px 2px 8px;transform:rotate(25deg)}
.brand strong{font-family:Georgia,"Times New Roman",serif;font-weight:500;letter-spacing:-.02em;font-size:18px}.brand span{display:block;color:var(--muted);font-size:10px;letter-spacing:.16em;text-transform:uppercase;margin-top:2px}
.status{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#7f7b78;border:1px solid rgba(255,255,255,.07);border-radius:999px;padding:8px 10px;background:rgba(255,255,255,.025)}
.stage-shell{flex:1;min-height:760px;position:relative;padding:24px clamp(14px,2.5vw,36px) 30px;display:flex;flex-direction:column}
.hero-copy{position:absolute;left:clamp(22px,5vw,78px);top:42px;z-index:8;max-width:430px;pointer-events:none}
.eyebrow{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#77747a;margin-bottom:10px}.hero-copy h1{font-family:Georgia,"Times New Roman",serif;font-weight:400;font-size:clamp(30px,4.4vw,66px);line-height:.98;letter-spacing:-.045em;margin:0;color:#f2eee7}.hero-copy p{max-width:360px;color:#8c8786;font-size:13px;line-height:1.6;margin:16px 0 0}
.tree-wrap{position:relative;flex:1;min-height:690px;overflow:hidden;border:1px solid rgba(255,255,255,.055);border-radius:28px;background:linear-gradient(180deg,rgba(14,15,19,.84),rgba(8,9,12,.96));box-shadow:var(--shadow);isolation:isolate}
.tree-wrap:before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);background-size:52px 52px;mask-image:linear-gradient(to bottom,transparent 0%,black 20%,black 82%,transparent 100%);pointer-events:none}
.tree-wrap:after{content:"";position:absolute;inset:0;background:radial-gradient(circle at 46% 48%,transparent 0 15%,rgba(0,0,0,.08) 50%,rgba(0,0,0,.25) 100%);pointer-events:none;z-index:1}
.flow-svg{position:absolute;inset:0;width:100%;height:100%;z-index:2;overflow:visible}
.connection-track{fill:none;stroke-width:var(--connection-base-stroke,1.45);vector-effect:non-scaling-stroke;opacity:var(--connection-base-opacity,.19);transition:opacity .45s ease,filter .45s ease}
.connection-active-outer{fill:none;stroke-width:9;vector-effect:non-scaling-stroke;opacity:0;filter:url(#connectionBloom);mix-blend-mode:screen;pointer-events:none;transition:opacity .16s ease}
.connection-active-inner{fill:none;stroke-width:2.25;vector-effect:non-scaling-stroke;opacity:0;filter:url(#sharpGlow);mix-blend-mode:screen;pointer-events:none;transition:opacity .12s ease}
.connection-memory{fill:none;stroke-width:1.7;vector-effect:non-scaling-stroke;opacity:0;filter:url(#memoryGlow);mix-blend-mode:screen;transition:opacity .5s ease}
.connection-hit{fill:none;stroke:transparent;stroke-width:20;pointer-events:stroke;cursor:default}.trail-dot{pointer-events:none;mix-blend-mode:screen}.tip-dot{pointer-events:none;mix-blend-mode:screen}.flow-bloom{mix-blend-mode:screen;pointer-events:none}
.tree-wrap.living-tree{box-shadow:var(--shadow),inset 0 0 90px rgba(65,140,255,.035)}
.nodes{position:absolute;inset:0;z-index:4}.moment{position:absolute;width:clamp(150px,15vw,218px);min-height:78px;border-radius:var(--node-radius,21px);transform:translate(-50%,-50%);background:linear-gradient(145deg,rgba(32,32,39,.74),rgba(14,15,20,.68));border:1px solid rgba(255,255,255,.045);box-shadow:inset 0 1px 0 rgba(255,255,255,.025),0 16px 45px rgba(0,0,0,.22);backdrop-filter:blur(12px);padding:14px 16px 13px 17px;transition:transform .35s cubic-bezier(.2,.8,.2,1),background .3s ease,box-shadow .35s ease;overflow:visible}
.moment:before{content:"";position:absolute;inset:7px;border-radius:calc(var(--node-radius,21px) - 7px);background:radial-gradient(circle at 18% 50%,var(--node-wash,rgba(243,236,222,.08)),transparent 50%);opacity:.55;pointer-events:none;transition:opacity .18s ease,filter .18s ease}.moment:after{content:"";position:absolute;inset:-10px;border-radius:calc(var(--node-radius,21px) + 10px);border:1px solid transparent;box-shadow:0 0 0 rgba(255,255,255,0);pointer-events:none;transition:box-shadow .22s ease,border-color .22s ease,opacity .22s ease;opacity:0}.moment.arrival:before{opacity:var(--arrival-wash-opacity,.86);filter:saturate(1.4) brightness(1.18)}.moment.arrival:after{border-color:color-mix(in srgb,var(--node-color) 64%,transparent);box-shadow:0 0 var(--arrival-halo,30px) color-mix(in srgb,var(--node-color) 34%,transparent),0 0 var(--arrival-bloom,78px) color-mix(in srgb,var(--node-color) 19%,transparent);opacity:1}.moment:hover{transform:translate(-50%,-50%) scale(1.022);background:linear-gradient(145deg,rgba(37,37,45,.86),rgba(16,17,22,.8));box-shadow:0 16px 52px rgba(0,0,0,.35),0 0 30px color-mix(in srgb,var(--node-color) 8%,transparent)}
.moment .kicker{position:relative;z-index:1;text-transform:uppercase;letter-spacing:.18em;font-size:8px;color:color-mix(in srgb,var(--node-color) 68%,#888);margin-bottom:7px}.moment .title{position:relative;z-index:1;font-family:Georgia,"Times New Roman",serif;font-size:17px;line-height:1.16;letter-spacing:-.018em;color:#e9e5df;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.moment .meta{position:relative;z-index:1;display:flex;justify-content:space-between;gap:8px;color:#706e72;font-size:9px;margin-top:8px}.moment .core{position:absolute;right:14px;top:14px;width:7px;height:7px;border-radius:50%;background:var(--node-color);box-shadow:0 0 12px color-mix(in srgb,var(--node-color) 45%,transparent);opacity:.18;transition:opacity .2s ease,box-shadow .2s ease,background .2s ease}.moment.awake .core{opacity:.86;box-shadow:0 0 12px color-mix(in srgb,var(--node-color) 70%,transparent),0 0 32px color-mix(in srgb,var(--node-color) 28%,transparent)}.moment.arrival .core{background:#fff;opacity:1;box-shadow:0 0 6px #fff,0 0 var(--arrival-core,22px) var(--node-color),0 0 var(--arrival-bloom,78px) color-mix(in srgb,var(--node-color) 28%,transparent)}
.node-track{fill:none;stroke:rgba(235,232,227,var(--track-opacity,.06));stroke-width:var(--stroke-width,1.3);vector-effect:non-scaling-stroke;pointer-events:none}.node-memory{fill:none;stroke-width:1.3;vector-effect:non-scaling-stroke;opacity:0;transition:opacity .45s ease}
.controls{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);z-index:9;display:flex;align-items:center;gap:8px;padding:7px;border:1px solid rgba(255,255,255,.075);background:rgba(15,16,20,.72);backdrop-filter:blur(14px);border-radius:999px;box-shadow:0 12px 42px rgba(0,0,0,.36)}.controls button{border:0;background:transparent;color:#9d9896;padding:10px 14px;border-radius:999px;font-size:10px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer;transition:.2s ease}.controls button:hover{background:rgba(255,255,255,.055);color:#eee8df}.controls .primary{background:#ebe5dc;color:#17171b;font-weight:700}.controls .primary:hover{background:#fffaf1;color:#111}.controls button:disabled{opacity:.35;cursor:not-allowed}
.timeline{position:absolute;left:clamp(18px,3vw,38px);right:clamp(18px,3vw,38px);bottom:86px;height:1px;background:rgba(255,255,255,.055);z-index:7}.timeline-fill{height:1px;width:0;background:linear-gradient(90deg,rgba(56,232,255,.56),rgba(139,92,255,.72),rgba(255,79,163,.72));box-shadow:0 0 13px rgba(65,140,255,.24);transition:width .08s linear}.timeline-label{position:absolute;right:0;top:10px;color:#57545a;font-size:8px;letter-spacing:.16em;text-transform:uppercase}
.message{position:absolute;right:clamp(22px,5vw,78px);top:122px;bottom:auto;z-index:8;text-align:right;max-width:360px;pointer-events:none;opacity:0;transform:translateY(8px);transition:opacity .8s ease,transform .8s ease}.message.visible{opacity:1;transform:none}.message strong{display:block;font-family:Georgia,"Times New Roman",serif;f