1,3,5];secondaries.forEach((idx,j)=>setTimeout(async()=>{if(token!==state.token||state.running)return;const p=edgePaths.get(edgesData[idx].id),[a,b]=edgePair(edgesData[idx]),c=mixColor(a,b,.52);await animateAlong(p,{duration:3200+j*420,color:c,start:0,end:1,token,tipScale:.48,intensity:.56})},820+j*620))
  }
  function resetVisual(keepEarlier=false){clearPulse();el.wrap.classList.remove('living-tree');nodeEls.forEach(n=>n.classList.remove('arrival','awake'));nodeMemory.forEach(p=>p.style.opacity=0);edgeMemory.forEach(p=>p.style.opacity=0);edgeActive.forEach(({outer,inner})=>{outer.style.opacity=0;inner.style.opacity=0});edgeBase.forEach(p=>p.style.opacity=state.mode==='benchmark'?params.trackOpacity:params.baseConnectionOpacity);el.timelineFill.style.width='0%';if(keepEarlier){for(let i=0;i<state.fromNode;i++){nodeEls.get(nodesData[i].id).classList.add('awake');nodeMemory.get(nodesData[i].id).style.opacity=.28;if(i<edgesData.length)edgeMemory.get(edgesData[i].id).style.opacity=state.mode==='benchmark'?.28:params.memoryTraceOpacity}}}
  function updateProgress(v){state.replayProgress=v;el.timelineFill.style.width=`${clamp(v,0,1)*100}%`}
  function togglePause(){if(!state.running)return;state.paused=!state.paused;el.pause.textContent=state.paused?'RESUME':'PAUSE'}
  function cycleSpeed(){const values=[.75,1,1.25,1.5,2],i=values.indexOf(state.speedMult);state.speedMult=values[(i+1)%values.length];el.speed.textContent=`SPEED ${state.speedMult}×`}
  function setMode(mode){state.mode=mode;el.app.classList.toggle('benchmark',mode==='benchmark');el.modeBenchmark.classList.toggle('active',mode==='benchmark');el.modeLoveTree.classList.toggle('active',mode==='lovetree');if(mode==='benchmark'){Object.assign(params,{speed:.8,trailLength:41,shimmerOpacity:.60,tipSize:1.8,borderRadius:13,strokeWidth:1.3,trackOpacity:.05,glowStrength:.92,baseConnectionOpacity:.05,activeConnectionOpacity:.32,memoryTraceOpacity:.28,colorSaturation:.6,arrivalImpact:.85,completedTreeGlow:.65})}else Object.assign(params,defaults);syncDebug();geom()}
