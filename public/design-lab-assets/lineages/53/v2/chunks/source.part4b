r:c,start:0,end:1,token,onProgress:r=>{mem.style.opacity=(state.mode==='benchmark'?(.10+.18*r):(.12+(params.memoryTraceOpacity-.12)*r)).toFixed(3)}});active.inner.style.opacity=0;active.outer.style.opacity=0;if(ok)mem.style.opacity=state.mode==='benchmark'?.28:params.memoryTraceOpacity;return ok}
  async function impact(index,token=state.token){if(token!==state.token)return false;const n=nodeEls.get(nodesData[index].id);n.classList.add('arrival','awake');await new Promise(r=>setTimeout(r,(210+params.arrivalImpact*38)/(params.speed*state.speedMult)));n.classList.remove('arrival');return token===state.token}
  async function startReplay(fromIndex=0){state.token++;const token=state.token;state.running=true;state.paused=false;state.fromNode=fromIndex;state.replayProgress=0;el.wrap.classList.remove('living-tree');el.message.classList.remove('visible');el.play.textContent='PLAYING';el.play.disabled=true;el.pause.textContent='PAUSE';resetVisual(fromIndex>0);const totalSteps=(nodesData.length-fromIndex)*2-1;let done=0;for(let i=fromIndex;i<nodesData.length;i++){
      const prev=i>fromIndex?nodesData[i-1].id:null,next=i<nodesData.length-1?nodesData[i+1].id:null;
      if(i===fromIndex) await impact(i,token);
      if(!await pulseNode(i,prev,next,token))break;done++;updateProgress(done/totalSteps);
      if(i<nodesData.length-1){if(!await pulseEdge(i,token))break;done++;updateProgress(done/totalSteps);if(!await impact(i+1,token))break}
    }
    if(token===state.token){state.running=false;el.play.disabled=false;el.play.textContent='PLAY PATH';updateProgress(1);startClimax(token)}
  }
  function startClimax(token){if(token!==state.token)return;el.wrap.classList.add('living-tree');const stable=state.mode==='benchmark'?.28:params.memoryTraceOpacity,peak=Math.min(.68,stable*(1+.42*params.completedTreeGlow));edgeMemory.forEach(p=>p.style.opacity=peak);nodeMemory.forEach(p=>p.style.opacity=Math.min(.58,.30+.13*params.completedTreeGlow));edgeBase.forEach(p=>p.style.opacity=state.mode==='benchmark'?params.trackOpacity:Math.min(.34,params.baseConnectionOpacity+.055*params.completedTreeGlow));nodesData.forEach(d=>nodeEls.get(d.id).classList.add('awake'));
    setTimeout(()=>{if(token!==state.token)return;edgeMemory.forEach(p=>p.style.opacity=stable);edgeBase.forEach(p=>p.style.opacity=state.mode==='benchmark'?params.trackOpacity:params.baseConnectionOpacity);el.message.classList.add('visible')},650);
