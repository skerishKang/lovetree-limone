'--arrival-halo',(20+impact*8)+'px');document.documentElement.style.setProperty('--arrival-bloom',(46+impact*25)+'px');document.documentElement.style.setProperty('--arrival-core',(12+impact*8)+'px');document.documentElement.style.setProperty('--arrival-wash-opacity',Math.min(.98,.58+impact*.2));
    document.querySelectorAll('.connection-track').forEach(p=>{p.style.strokeWidth=Math.max(1.2,Math.min(1.6,params.strokeWidth))+'px';p.style.opacity=state.mode==='benchmark'?params.trackOpacity:params.baseConnectionOpacity});
    document.querySelectorAll('.connection-active-inner').forEach(p=>{p.style.strokeWidth=Math.min(3,Math.max(1.8,params.strokeWidth*1.55))+'px'});document.querySelectorAll('.connection-active-outer').forEach(p=>{p.style.strokeWidth=(6+params.glowStrength*3.2)+'px'});
    document.querySelectorAll('.connection-memory').forEach(p=>{p.style.strokeWidth=Math.min(2.2,Math.max(1.35,params.strokeWidth*1.15))+'px'});document.querySelectorAll('.node-track').forEach(p=>{p.style.strokeWidth=params.strokeWidth;p.style.stroke=`rgba(235,232,227,${params.trackOpacity})`});updatePalette()
  }
  const rafWait=()=>new Promise(r=>requestAnimationFrame(r));
  async function waitWhilePaused(token){while(state.paused&&token===state.token) await new Promise(r=>setTimeout(r,50))}
  function clearPulse(){el.trailLayer.replaceChildren();el.tipLayer.replaceChildren()}
  function animateAlong(path,{duration=900,color='#fff',start=0,end=1,token=state.token,onProgress=null,tipScale=1,intensity=1}={}){
    return new Promise(resolve=>{const L=path.getTotalLength(),trailN=clamp(Math.round(params.trailLength/2.45),6,34),tipR=params.tipSize*tipScale,halo=svgEl('circle',{r:tipR*3.45,fill:color,opacity:.17*params.glowStrength*intensity,class:'flow-bloom',filter:'url(#hotGlow)'}),tip=svgEl('circle',{r:tipR,fill:'#ffffff',class:'tip-dot',filter:'url(#sharpGlow)'});el.tipLayer.append(halo,tip);const dots=[];for(let i=0;i<trailN;i++){const c=svgEl('circle',{r:Math.max(.55,tipR*(1-i/trailN)*.76),fill:color,class:'trail-dot'});c.setAttribute('filter','url(#softGlow)');el.trailLayer.appendChild(c);dots.push(c)}let t0=performance.now(),pausedAt=0;
      function frame(now){if(token!==state.token){tip.remove();halo.remove();dots.forEach(d=>d.remove());return resolve(false)}if(state.paused){pausedAt=now;return requestAnimationFrame(frame)}if(pausedAt){t0+=now-pausedAt;pausedAt=0}const raw=clamp((now-t0)/(duration/(params.speed*state.s