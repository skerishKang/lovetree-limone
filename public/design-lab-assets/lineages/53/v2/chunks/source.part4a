  function anchorFraction(nodeId,towardId){const p=nodePaths.get(nodeId),L=p.getTotalLength();const nb=nodeEls.get(nodeId).getBoundingClientRect(),tb=nodeEls.get(towardId).getBoundingClientRect(),rb=el.wrap.getBoundingClientRect();const target={x:tb.left-rb.left+tb.width/2,y:tb.top-rb.top+tb.height/2};let best=0,dist=Infinity;for(let i=0;i<=120;i++){const q=p.getPointAtLength(L*i/120),dd=(q.x-target.x)**2+(q.y-target.y)**2;if(dd<dist){dist=dd;best=i/120}}return best}
